e7e8979e-a6b2-4af2-aa81-2fa80dfa8935,https://www.google.com/maps/place/Casas+Casablanca/data=!4m7!3m6!1s0x9662673b5540fe5f:0xf03f43f0700e033d!8m2!3d-33.3477271!4d-71.3710172!16s%2Fg%2F11kjp4p9yx!19sChIJX_5AVTtnYpYRPQMOcPBDP_A?authuser=0&hl=en&g_ep=EgoyMDI2MDkxNS4wIJJjKgBIAVAD&rclk=1,Casas Casablanca,Modular home builder,"8B Mundo Nuevo, 2480000 Casablanca, Valparaíso","{""Friday"":[""Closed""],""Monday"":[""Closed""],""Saturday"":[""10:30 AM–6 PM""],""Sunday"":[""Closed""],""Thursday"":[""10 AM–5 PM""],""Tuesday"":[""10 AM–5 PM""],""Wednesday"":[""Closed""]}",{},https://www.casascasablanca.cl/,9 4965 4682,MJ2H+WH Casablanca,10,4.300000,"{""1"":1,""2"":1,""3"":0,""4"":0,""5"":8}",-33.347727,-71.371017,17311630192586654525,,,,https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmSRdjzgrfwNAlMYCQQvytb0Lf8N3IJOK_sJlPRnprYDjfaN5aswLujcmxFZ6WbZ9NXtUbh-WJGf7hZNaGEQqAp0kTtxgMpwqJtLQUqNiznC5gQ9YqmRv2Bg4e5Pvnc2uSR737jnQ=w648-h240-k-no,America/Santiago,,0x9662673b5540fe5f:0xf03f43f0700e033d,https://www.google.com/maps/@?api=1&map_action=pano&pano=qJVr69dVLJAfR2b5vEyeJA,ChIJX_5AVTtnYpYRPQMOcPBDP_A,"[{""title"":""All"",""image"":""https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmSRdjzgrfwNAlMYCQQvytb0Lf8N3IJOK_sJlPRnprYDjfaN5aswLujcmxFZ6WbZ9NXtUbh-WJGf7hZNaGEQqAp0kTtxgMpwqJtLQUqNiznC5gQ9YqmRv2Bg4e5Pvnc2uSR737jnQ=w804-h298-k-no""},{""title"":""Tile"",""image"":""https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkJSSasug9oSowxzhU8K86yd7qDBC2D2fkbHOXmUQt1CqqbRaqGu2Jyutw4VFukLN6SUUhRBL9GkFAr2ngJDS0FMQ2Kb6TrH7GlfcZ9pb9Z7i6O0GWJ9gclelPzXUIuPQkXSumlQA=w545-h298-k-no""},{""title"":""By owner"",""image"":""https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkkmH2DYC7FPkUsd-RAJdZiTSwL6yqZ5odkD1XKE63uHCEf0X3e65Lnbo6zJioXm9cZ_otAsYTeCvFNBw6JnqGWogc0U0x9mBcHyul8tm9CYLMbzf5UJvCB5F9NexVeddKOKrBU=w530-h298-k-no""},{""title"":""Street View \u0026 360°"",""image"":""https://streetviewpixels-pa.googleapis.com/v1/thumbnail?panoid=qJVr69dVLJAfR2b5vEyeJA\u0026cb_client=maps_sv.tactile.gps\u0026w=224\u0026h=298\u0026yaw=284.62955\u0026pitch=0\u0026thumbfov=100""}]",null,null,"{""link"":"""",""source"":""""}","{""id"":""103755118846953154741"",""name"":""Casas Casablanca (Owner)"",""link"":""https://www.google.com/maps/contrib/103755118846953154741""}","{""borough"":"""",""street"":""8B Mundo Nuevo"",""city"":""Casablanca"",""postal_code"":""2480000"",""state"":""Valparaíso"",""country"":""CL""}",,"[{""id"":""from_the_business"",""name"":""From the business"",""options"":[{""name"":""Identifies as women-owned"",""enabled"":true}]},{""id"":""service_options"",""name"":""Service options"",""options"":[{""name"":""Online estimates"",""enabled"":true},{""name"":""On-site services"",""enabled"":true}]},{""id"":""accessibility"",""name"":""Accessibility"",""options"":[{""name"":""Wheelchair-accessible seating"",""enabled"":true},{""name"":""Wheelchair-accessible toilet"",""enabled"":true}]},{""id"":""crowd"",""name"":""Crowd"",""options"":[{""name"":""LGBTQ+ friendly"",""enabled"":true},{""name"":""Transgender safe space"",""enabled"":true}]},{""id"":""parking"",""name"":""Parking"",""options"":[{""name"":""Free parking lot"",""enabled"":true},{""name"":""On-site parking"",""enabled"":true}]}]","[{""Name"":""Karen Ulloa"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjX1mrznBEulyYm2Gx2VjXQ6DORX9_l_3oQVAZIiC3LBBLrZX-U=s120-c-rp-mo-ba12-br100"",""Rating"":1,""Description"":""Contratamos a Casas Casablanca para construir nuestra casa en modalidad “llave en mano” y lamentablemente la experiencia ha sido muy mala, especialmente en la postventa.\nLa vivienda fue entregada con problemas graves desde el inicio, incluyendo una fuga de gas y un problema sanitario que hasta hoy genera malos olores constantes en el baño, haciendo muy incómodo vivir en la casa. Además, hay múltiples fallas en terminaciones, instalaciones deficientes y errores en mobiliario que no fueron corregidos adecuadamente.\nDurante meses hemos informado todos estos problemas, pero las soluciones han sido parciales o inexistentes. Incluso se nos indicó que algunas reparaciones no se realizarían mientras no se pagara un cobro adicional por concepto de cámaras de agua, el cual fue informado con posterioridad al contrato y no de manera previa, lo que resulta inapropiado considerando que se trata de fallas de construcción.\nFuera de todos los detalles, que son más de los que se muestran en las fotos, lo más grave es el olor constante que genera el baño, ya que hace inhabitable vivir en esas condiciones, especialmente considerando que se trata de adultos mayores.\nSe envió una carta formal solicitando solución y plazos de reparación, la cual no fue respondida dentro del plazo indicado. Actualmente el caso se encuentra en proceso mediante SERNAC y asesoría legal.\nNo recomendaría esta empresa, especialmente por su deficiente servicio de postventa."",""Images"":[""https://lh3.googleusercontent.com/grass-cs/ACvplmPRUvEbxKWN7SIskVbhAUy-VdMH9u7D-Hr8RTRgbsQm5C6-5ws9TkTuiYpNqtjuht5B0HqBx4FaWdJtRQpH9kz45l_2JzdTlNblnKML2W2f6J_YvHu88L5VnFwiHE9i7emHUbBuoR2NS2U1=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmNqaitCB-ZtolV6UP5k_2xemCx9dEWXCEWVlVi5Hw9Y_jhGoWmHxG0fOxQTGgAbnsciOfPLmtAGKIHwIauCjmA68wHX_Ch2rsPMZqnTfnSKfW7Xu3A_y-zMNYDIRQsageu6zv7tEU1cYwD3=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmNi_5UgrqP7myaC_tcqg7OGxEylO9keNfqB_mXJjD678zLMCNtKQxGSF-SVKY8iOc-ySyGM7wQzFNpU1cunEC6CeGkESj-_tZRCOzm7WssZ8VqKd97oxP_O8ALA5-JpxkNpRO-c10Ffc9I=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmNApD1U-zz8GGe50dvLiiC0lmMLacOD2qwB73c-vJOVKqeIsE7mLnY6g_n-AWXyi2DRutfE6G2qeEh14zpXUuPInVlnNF5f9-MySpp_uMiBdgwebeyb1Gi9PXp9M626JvDMLyXLxKQ16MOJ=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmN1yVIlsg8ZngS8ncSgG9Ur-hS9m22MQU875vfctdxOgidnKRs_eg5o06Hep-bDwuszz1NlqmL11vHEosY8eCV11cVPXrFJMA-WYQKILI3MzQjUSFNPQGsd_rSETre2c4xvOlGZ6rBYP1bE=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmN3kKMW9mrEEdRhZB9miRZbfPbOYUM6Twj8Fyk9WM1FugUm-TnAaWjFziRvk9Or4GxvQ0rbzi