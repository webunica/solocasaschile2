CNKR4z_QHVgnYzxaEZij6hk0vUiXrQ=w397-h298-k-no""},{""title"":""Street View \u0026 360°"",""image"":""https://streetviewpixels-pa.googleapis.com/v1/thumbnail?panoid=a8A7F8-5m-002sBeZg8TDw\u0026cb_client=maps_sv.tactile.gps\u0026w=224\u0026h=298\u0026yaw=150.19011\u0026pitch=0\u0026thumbfov=100""}]",null,null,"{""link"":"""",""source"":""""}","{""id"":""102161648992318980246"",""name"":""Casas Arragon (Owner)"",""link"":""https://www.google.com/maps/contrib/102161648992318980246""}","{""borough"":"""",""street"":""Ruta D 41, Lote 7, Parcela 45"",""city"":""La Serena"",""postal_code"":"""",""state"":""Coquimbo"",""country"":""CL""}",,null,"[{""Name"":""Oscar Figueroa"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjUKSkVj6immdjwhLarhbmXKCDrDOUcSTRhmsJUSZTXP08RvalNW=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Hace 8 meses llevé a una persona que me hacia dedo, resultó ser un ejecutivo de ventas de una ferretería al por mayor en La Serena, entonces le conté de mi proyecto de construcción de casa con Camilo Ascuii de casas ARRAGÓN, entonces el me digo que el con todos los años de circo que tenía en el rubro de construcción solo recomendaría a tres personas y una de ellas es Camilo Ascuii . Pasaron los meses y mi proyecto de casa ya es una realidad y  la alta calidad de los materiales y la calidad técnica hicieron la diferencia ,  la casa es exquisita. Les recomiendo invertir con Arragón"",""Images"":null,""When"":""5 years ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSUN5OHFHYjFRRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/113712518579063880481/reviews?hl=en-GB"",""posted_at_unix_micros"":1611587762494428,""updated_at_unix_micros"":1611587762494428,""language"":""es"",""translated_lang"":""en"",""text_original"":""Hace 8 meses llevé a una persona que me hacia dedo, resultó ser un ejecutivo de ventas de una ferretería al por mayor en La Serena, entonces le conté de mi proyecto de construcción de casa con Camilo Ascuii de casas ARRAGÓN, entonces el me digo que el con todos los años de circo que tenía en el rubro de construcción solo recomendaría a tres personas y una de ellas es Camilo Ascuii . Pasaron los meses y mi proyecto de casa ya es una realidad y  la alta calidad de los materiales y la calidad técnica hicieron la diferencia ,  la casa es exquisita. Les recomiendo invertir con Arragón"",""text_translated"":""Eight months ago, I gave a ride to someone who was hitchhiking. It turned out he was a sales executive at a wholesale hardware store in La Serena. I told him about my house construction project with Camilo Ascuii of Arragón Homes. He told me that with all his years of experience in the construction industry, he would only recommend three people, and Camilo Ascuii was one of them. Months passed, and my house project is now a reality. The high quality of the materials and the technical expertise made all the difference; the house is exquisite. I highly recommend investing with Arragón."",""published_at"":""2021-01-25T15:16:02.494428Z""},{""Name"":""Rodolfo Toledo"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjU4W2HsLMfnDR3OeeW_jue-S-K6oIfS19v5m_kVlYKtaBnQeyk=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Construimos nuestra casa en La Serena mientras vivíamos en Santiago. Camilo con su constructora muy responsables y dedicados. 100% recomendables.\n\nTuvimos experiencia con otra constructora y fue diametralmente opuesta.\n\nAfortunadamente encontramos una constructora seria que nos construyera nuestra casa correctamente a pesar de no estar nosotros presentes."",""Images"":null,""When"":""3 years ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSUNCdmJiTWtnRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/105187463940847149173/reviews?hl=en-GB"",""posted_at_unix_micros"":1672666026877826,""updated_at_unix_micros"":1672666198180449,""language"":""es"",""translated_lang"":""en"",""text_original"":""Construimos nuestra casa en La Serena mientras vivíamos en Santiago. Camilo con su constructora muy responsables y dedicados. 100% recomendables.\n\nTuvimos experiencia con otra constructora y fue diametralmente opuesta.\n\nAfortunadamente encontramos una constructora seria que nos construyera nuestra casa correctamente a pesar de no estar nosotros presentes."",""text_translated"":""We built our house in La Serena while living in Santiago. Camilo and his construction company were very responsible and dedicated. 100% recommended.\n\nWe had a completely different experience with another construction company.\n\nFortunately, we found a reputable company that built our house correctly even though we weren't there."",""published_at"":""2023-01-02T13:27:06.877826Z""},{""Name"":""Nicolas Papic"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocIJOfQvfqciIBXedjdVVqzBDTx2JQOvs58z77IyDvvP7zGfiw=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Super profesionales, totalmente recomendables. Cumplieron con los plazos y el presupuesto."",""Images"":null,""When"":""6 years ago"",""review_id"":""ChZDSUhNMG9nS0VJQ0FnSUNNdVpISUpREAE"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/116146360050984199862/reviews?hl=en-GB"",""posted_at_unix_micros"":1574795710354953,""updated_at_unix_micros"":1574795710354953,""language"":""es"",""translated_lang"":""en"",""text_original"":""Super profesionales, totalmente recomendables. Cumplieron con los plazos y el presupuesto."",""text_translated"":""Super professional, highly recommended. They met the deadlines and stayed within budget."",""published_at"":""2019-11-26T19:15:10.354953Z""},{""Name"":""Ivan Gomez"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocJ4PbKuzuZPu2hzvIx4cWLyd4YXuDfdFiEqp4HZrze-Y54OzQ=s120-c-rp-mo-ba12-br100"",""Rating"":5,""Description"":"""",""Images"":null,""When"":""4 years a