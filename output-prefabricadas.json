97-h298-k-no""},{""title"":""By owner"",""image"":""https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmShBNveym_SxcBcNieBYI8PSU3zkN-BaSgFgehJD1a74Y5d2n3xe9qbojCKyOZwENPwrAEFgr-TMBZlH4xkxvDOC8t_cYp4h79B3XZLWt7Blj1odPxX9gxfybuZEDpvbN0PUsW=w531-h298-k-no""}]",null,null,"{""link"":"""",""source"":""""}","{""id"":""102730629654693489700"",""name"":""Casas Chile (Owner)"",""link"":""https://www.google.com/maps/contrib/102730629654693489700""}","{""borough"":"""",""street"":""Av. Pdte. Jorge Alessandri Rodríguez 19679"",""city"":""San Bernardo"",""postal_code"":"""",""state"":""Santiago Metropolitan Region"",""country"":""CL""}",,"[{""id"":""accessibility"",""name"":""Accessibility"",""options"":[{""name"":""Wheelchair-accessible car park"",""enabled"":true},{""name"":""Wheelchair-accessible entrance"",""enabled"":true}]}]","[{""Name"":""roberto andres lobos gallardo"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocJ0F_zQXaoJ_v2TvtR3yF_GKcI-TvVns1BMcBn856TmWHcsiQ=s120-c-rp-mo-br100"",""Rating"":1,""Description"":""Carisimo"",""Images"":null,""When"":""4 years ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSURPbk1Xbzl3RRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":1,""author_url"":""https://www.google.com/maps/contrib/102565797337003910105/reviews?hl=en-GB"",""posted_at_unix_micros"":1656550164889990,""updated_at_unix_micros"":1656550176369348,""language"":""en"",""translated_lang"":"""",""text_original"":""Carisimo"",""text_translated"":"""",""reply_text"":""Hello, we regret the comment, but upon reviewing our records, we found no record of you as a Casas Chile client, nor is there any contract associated with your name.\n\nIf you believe this is an error, you can write to us at sac@casaschilespa.cl\n\nso we can review it directly.\n\nWe continue working with Google to remove fake reviews and protect the reputation of those who have trusted us for over 8 years."",""reply_text_original"":""Hola, lamentamos el comentario, pero al revisar nuestros registros no figura como cliente de Casas Chile ni existe ningún contrato asociado a su nombre.\n\nSi cree que se trata de un error, puede escribirnos a sac@casaschilespa.cl\n para revisarlo directamente.\n\nSeguimos trabajando con Google para eliminar reseñas falsas y proteger la reputación de quienes sí han confiado en nosotros durante más de 8 años."",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1762355164000000,""reply_updated_at_unix_micros"":1762355164000000,""published_at"":""2022-06-30T00:49:24.88999Z""},{""Name"":""Karol Barrera Galdámez"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocJo2zKxuhxx2EO2dW0qS8m0c-RvvLxCHI5YojUuvioavjxNUdo=s120-c-rp-mo-br100"",""Rating"":1,""Description"":""Mi experiencia con Casas Chile ha sido muy decepcionante. Desde marzo de 2026 hemos estado solicitando la devolución de un dinero que la propia empresa reconoció que debía restituir. Sin embargo, después de meses de correos, llamados telefónicos, visitas presenciales y reclamos ante SERNAC, seguimos sin recibir una solución definitiva.\nLo más frustrante ha sido la falta de comunicación y seguimiento. Cada vez responde una persona distinta, entregan información diferente y los compromisos asumidos no se cumplen. Incluso propusieron un plan de devolución ante SERNAC que posteriormente tampoco respetaron.\nMás allá del dinero, lo que más cuestiono es la atención al cliente y la falta de seriedad para gestionar un problema que lleva meses sin resolverse. No recomendaría esta experiencia a otras personas."",""Images"":null,""When"":""a month ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT2xWM1EwaG9SRTFZTmw5RU1USlpUR1V3YlZvMWRrRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":1,""author_url"":""https://www.google.com/maps/contrib/112411086828610200305/reviews?hl=en-GB"",""posted_at_unix_micros"":1785203353431832,""updated_at_unix_micros"":1785203353431832,""language"":""es"",""translated_lang"":""en"",""text_original"":""Mi experiencia con Casas Chile ha sido muy decepcionante. Desde marzo de 2026 hemos estado solicitando la devolución de un dinero que la propia empresa reconoció que debía restituir. Sin embargo, después de meses de correos, llamados telefónicos, visitas presenciales y reclamos ante SERNAC, seguimos sin recibir una solución definitiva.\nLo más frustrante ha sido la falta de comunicación y seguimiento. Cada vez responde una persona distinta, entregan información diferente y los compromisos asumidos no se cumplen. Incluso propusieron un plan de devolución ante SERNAC que posteriormente tampoco respetaron.\nMás allá del dinero, lo que más cuestiono es la atención al cliente y la falta de seriedad para gestionar un problema que lleva meses sin resolverse. No recomendaría esta experiencia a otras personas."",""text_translated"":""My experience with Casas Chile has been very disappointing. Since March 2026, we have been requesting a refund that the company itself acknowledged it owed. However, after months of emails, phone calls, in-person visits, and complaints to SERNAC (Chile's National Consumer Service), we still haven't received a definitive solution.\nThe most frustrating aspect has been the lack of communication and follow-up. Each time, a different person responds, they provide different information, and the commitments made are not honored. They even proposed a refund plan to SERNAC, which they later failed to honor.\nBeyond the money, what I question most is the customer service and the lack of seriousness in handling a problem that has gone unresolved for months. I would not recommend this experience to others."",""published_at"":""2026-07-28T01:49:13.431832Z""},{""Name"":""Laura Galdamez"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocKJfute6wM1gBGW-OM_i3Ayic3PlHe0byuforaL2zEkHqxIYQ=s120-c-rp-mo-br100"",""Rating"":1,""Description"":""Mi experiencia con Casas Chile ha sido extremadamente mala y desgastante. Después de pagar el contrato al contado, he pasado meses intentando obtener la devolución de un dinero que la propia empresa reconoció que debe restituir.\nLo más frustrante no ha sido solo la demora, sino la forma en que han manejado el caso. He recibido promesas que no se cumplen, fechas que no se respetan, llamados que nunca son devueltos y respuestas distintas según la persona con la que se logre hablar. Cada vez aparece un nuevo responsable, mientras nadie entrega una solución concreta ni una fecha real de devolución.\nIncluso después de reclamos ante SERNAC, la empresa propuso un plan de pagos que tampoco cumplió. A la fecha sigo esperando una respuesta formal y el pago del saldo pendiente. La sensación es de absoluto abandono como cliente, teniendo que insistir constantemente para obtener información sobre un dinero que me pertenece.\nLa falta de seriedad, profesionalismo, organización y respeto hacia el cliente ha sido evidente durante todo este proceso. Nunca imaginé que recuperar mi propio dinero implicaría tantos meses de incertidumbre, excusas e incumplimientos. Sin duda, una de las peores experiencias de atención al cliente que he tenido."",""Images"":null,""When"":""a month ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT2pKRFF6QTVkamh6YW5ob2RVbGFMVFJZVm5NNVRHYxAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":1,""author_url"":""https://www.google.com/maps/contrib/110104151622944454306/reviews?hl=en-GB"",""posted_at_unix_micros"":1785203501618491,""updated_at_unix_micros"":1785203501618491,""language"":""es"",""translated_lang"":""en"",""text_original"":""Mi experiencia con Casas Chile ha sido extremadamente mala y desgastante. Después de pagar el contrato al contado, he pasado meses intentando obtener la devolución de un dinero que la propia empresa reconoció que debe restituir.\nLo más frustrante no ha sido solo la demora, sino la forma en que han manejado el caso. He recibido promesas que no se cumplen, fechas que no se respetan, llamados que nunca son devueltos y respuestas distintas según la persona con la que se logre hablar. Cada vez aparece un nuevo responsable, mientras nadie entrega una solución concreta ni una fecha real de devolución.\nIncluso después de reclamos ante SERNAC, la empresa propuso un plan de pagos que tampoco cumplió. A la fecha sigo esperando una respuesta formal y el pago del saldo pendiente. La sensación es de absoluto abandono como cliente, teniendo que insistir constantemente para obtener información sobre un dinero que me pertenece.\nLa falta de seriedad, profesionalismo, organización y respeto hacia el cliente ha sido evidente durante todo este proceso. Nunca imaginé que recuperar mi propio dinero implicaría tantos meses de incertidumbre, excusas e incumplimientos. Sin duda, una de las peores experiencias de atención al cliente que he tenido."",""text_translated"":""My experience with Casas Chile has been extremely bad and exhausting. After paying for the contract in cash, I've spent months trying to get a refund of money that the company itself acknowledged it owes.\n\nThe most frustrating thing hasn't just been the delay, but the way they've handled the case. I've received broken promises, missed deadlines, calls that are never returned, and different answers depending on who I manage to speak to. Each time, a new person in charge appears, while no one provides a concrete solution or a realistic refund date.\nEven after filing complaints with SERNAC (Chile's National Consumer Service), the company proposed a payment plan that they also failed to honor. To this day, I'm still waiting for a formal response and payment of the outstanding balance. I feel completely abandoned as a customer, having to constantly insist to get information about money that is rightfully mine.\nThe lack of seriousness, professionalism, organization, and respect for the customer has been evident throughout this entire process. I never imagined that recovering my own money would involve so many months of uncertainty, excuses, and broken promises. Without a doubt, one of the worst customer service experiences I've ever had."",""published_at"":""2026-07-28T01:51:41.618491Z""},{""Name"":""jaime betancourt garrido"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjVpIq6HI_pCgX54osdnulmGOTqk3khtXpuZMxJbRRQJjV_XP69Xdg=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Tuve una excelente experiencia trabajando con Casas Chile. Desde el primer momento demostraron compromiso, seriedad y un nivel de profesionalismo que realmente marca la diferencia. Recibí mi casa exactamente como la había imaginado: cada detalle, cada espacio y cada terminación fueron entregados tal cual lo había planeado.\n\nEl equipo se mostró siempre dispuesto a escuchar, orientar y buscar las mejores alternativas para que el resultado final fuera perfecto. Agradezco profundamente su dedicación y el trabajo que realizaron; es reconfortante encontrarse con personas tan responsables, transparentes y apasionadas por lo que hacen."",""Images"":null,""When"":""9 months ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT2paVlpHVlFNMU5qT0dod2NGRkVTRXRWY1ZKUVYyYxAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/114548035653096627955/reviews?hl=en-GB"",""posted_at_unix_micros"":1765129917961877,""updated_at_unix_micros"":1765129917961877,""language"":""es"",""translated_lang"":""en"",""text_original"":""Tuve una excelente experiencia trabajando con Casas Chile. Desde el primer momento demostraron compromiso, seriedad y un nivel de profesionalismo que realmente marca la diferencia. Recibí mi casa exactamente como la había imaginado: cada detalle, cada espacio y cada terminación fueron entregados tal cual lo había planeado.\n\nEl equipo se mostró siempre dispuesto a escuchar, orientar y buscar las mejores alternativas para que el resultado final fuera perfecto. Agradezco profundamente su dedicación y el trabajo que realizaron; es reconfortante encontrarse con personas tan responsables, transparentes y apasionadas por lo que hacen."",""text_translated"":""I had an excellent experience working with Casas Chile. From the very first moment, they demonstrated commitment, seriousness, and a level of professionalism that truly makes a difference. I received my house exactly as I had imagined it: every detail, every space, and every finish was delivered just as I had planned.\n\nThe team was always willing to listen, guide, and find the best alternatives to ensure the final result was perfect. I am deeply grateful for their dedication and the work they did; it is heartwarming to encounter such responsible, transparent, and passionate people."",""published_at"":""2025-12-07T17:51:57.961877Z""},{""Name"":""Lucius Vidal"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocJuNjKZ2TzAMtWnqW6vcCxQvGF-fjPKLBBQdytUSHXb45wpmgY=s120-c-rp-mo-br100"",""Rating"":4,""Description"":""Buena experiencia en general con Casas Chile SpA. El servicio de postventa funciona bien, responden dentro de tiempos razonables y muestran buena disposición para ayudar. Se agradece que tengan canales claros para gestionar dudas y garantías. Como mejora, podrían ser un poco más rápidos en algunos casos, pero en general cumplen bien"",""Images"":null,""When"":""5 months ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT2taMWNtWTFXRXRrYm5oMVkxTTJSRFJIWVdwVVEzYxAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":4,""author_url"":""https://www.google.com/maps/contrib/116006289603343361305/reviews?hl=en-GB"",""posted_at_unix_micros"":1776383264060692,""updated_at_unix_micros"":1776383264060692,""language"":""es"",""translated_lang"":""en"",""text_original"":""Buena experiencia en general con Casas Chile SpA. El servicio de postventa funciona bien, responden dentro de tiempos razonables y muestran buena disposición para ayudar. Se agradece que tengan canales claros para gestionar dudas y garantías. Como mejora, podrían ser un poco más rápidos en algunos casos, pero en general cumplen bien"",""text_translated"":""Overall, a good experience with Casas Chile SpA. Their after-sales service works well; they respond within reasonable timeframes and are very helpful. It's appreciated that they have clear channels for handling inquiries and warranty claims. As an area for improvement, they could be a little faster in some cases, but generally, they perform well."",""published_at"":""2026-04-16T23:47:44.060692Z""},{""Name"":""Pablo Espinosa Guerra"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjVEx9EL-vgl58gXHbXMaHP6TqswEE8njmUtRCsOt_pm1Fc_ht8h4w=s120-c-rp-mo-ba12-br100"",""Rating"":1,""Description"":""Compré un Kit Básico Temuco 36 m², Folio N° 20010, atendido por Carolina Espinosa.\nLa entrega estaba comprometida para el 30 de diciembre y llegó el 3 de enero, sin aviso ni respaldo de despacho. Nadie pudo indicar qué se despachó ni a qué transportista.\n\nLa casa llegó con planchas de yeso cartón quebradas y se negaron a reponerlas con despacho, pese a estar pagado. Tuve que retirarlas y trasladarlas yo mismo.\nAdemás, la vivienda llegó sin pernos de anclaje, impidiendo el armado. A la fecha, aún espero la factura de venta.\n\nCero postventa, nula respuesta y total informalidad. No lo recomiendo."",""Images"":[""https://lh3.googleusercontent.com/grass-cs/ACvplmOhHLEbI0GNEL6-zvN-7efn8pNOzb-_tGaD21aWNrNMGwu9WECUXgyaw92XsBMIovHRZql_l9wf4ZACI1oCYqO7Wcmh7UiLosOegVUn6FQ6bp8_nbW68cB8blqd--C45P1Oj7-HZDsx7tPE=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmOGkjtnLNWV5RAG0CaPuNXzRgN4pfvrpa5Tz2tTAAZRKnFCN4-86hzUIoSyEFBohgV_TBZz3WhUXy75tEh7EcGk6uRYZWbMgAVEe631FopZe1QJ1TayJzqQvfwCPAO6KzngvNgF1dpy3MIP=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmMsaYC6-sK0MZbKY_rOwCjo6KnZXuhqOrh7Cs95okbVBPR_H1oz9UFLq7v4Ze7v4JaU8FqBP6asx_obHOS-gp-TymiREJu03VfzR2JITplI6ZarLc5gF_3Y_2C98Mq3CIiRIoOaS_gHxj1W=k-no""],""When"":""7 months ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT21KQ01HMUJkRkpXVW5obVYxWXlkeTFCTUc1eGNtYxAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":1,""author_url"":""https://www.google.com/maps/contrib/114535691830724336027/reviews?hl=en-GB"",""posted_at_unix_micros"":1768945298154915,""updated_at_unix_micros"":1768945298154915,""language"":""es"",""translated_lang"":""en"",""text_original"":""Compré un Kit Básico Temuco 36 m², Folio N° 20010, atendido por Carolina Espinosa.\nLa entrega estaba comprometida para el 30 de diciembre y llegó el 3 de enero, sin aviso ni respaldo de despacho. Nadie pudo indicar qué se despachó ni a qué transportista.\n\nLa casa llegó con planchas de yeso cartón quebradas y se negaron a reponerlas con despacho, pese a estar pagado. Tuve que retirarlas y trasladarlas yo mismo.\nAdemás, la vivienda llegó sin pernos de anclaje, impidiendo el armado. A la fecha, aún espero la factura de venta.\n\nCero postventa, nula respuesta y total informalidad. No lo recomiendo."",""text_translated"":""I purchased a Temuco Basic Kit (36 m²), Folio No. 20010, through Carolina Espinosa.\nDelivery was scheduled for December 30th but arrived on January 3rd, without any notification or shipping confirmation. No one could tell me what was shipped or which carrier it was sent to.\n\nThe house arrived with broken drywall panels, and they refused to replace them, even though I had already paid. I had to remove and transport them myself.\n\nFurthermore, the house arrived without anchor bolts, making assembly impossible. To this day, I am still waiting for the sales invoice.\n\nZero after-sales service, no response, and completely unprofessional. I do not recommend them."",""reply_text"":""Hi Pablo, thank you for taking the time to share your experience.\n\nWe sincerely regret that the process did not go as expected. We understand how frustrating it can be to coordinate a delivery of this type and to encounter issues at such important stages of the project.\n\nWe want to clarify that, regarding the points mentioned, we took the necessary steps to meet the agreed-upon loading date, and we also arranged compensation for the damaged materials once the situation was reported. As for the fasteners and transportation, these aspects are detailed in the contract and were communicated during the quotation process.\n\nRegarding the invoice, we confirm that it was issued on January 21st, taking into account the data modification request made subsequently, which slightly extended the administrative timeframe.\n\nEven so, we believe the entire experience could have been better communicated and supported, and we consider this feedback an opportunity to continue improving our after-sales and coordination processes.\n\nWe are fully available to review your case in detail and resolve any outstanding issues through our formal customer service channels. You can also write to us directly at sac@casaschilespa.cl\n\nWe are committed to continuous improvement and providing responsible solutions to each of our clients."",""reply_text_original"":""Hola Pablo, gracias por tomarte el tiempo de compartir tu experiencia.\n\nLamentamos sinceramente que el proceso no haya sido el esperado. Entendemos lo frustrante que puede ser coordinar una entrega de este tipo y que existan inconvenientes en etapas tan importantes del proyecto.\n\nQueremos aclarar que, respecto a los puntos mencionados, desde nuestra parte se realizaron las gestiones correspondientes para cumplir con la fecha de carga comprometida, así como también se gestionó la compensación por los materiales dañados una vez informada la situación. En cuanto a los elementos de fijación y el transporte, estos aspectos se encuentran detallados en el contrato y fueron informados durante el proceso de cotización.\n\nRespecto a la facturación, confirmamos que esta fue emitida el 21 de enero, considerando la solicitud de modificación de datos realizada posteriormente, lo que extendió levemente el plazo administrativo.\n\nAun así, asumimos que la experiencia completa pudo haberse comunicado y acompañado de mejor manera, y tomamos este comentario como una oportunidad para seguir mejorando nuestros procesos de postventa y coordinación.\n\nQuedamos totalmente disponibles para revisar tu caso en detalle y cerrar cualquier punto pendiente a través de nuestros canales formales de atención. Puedes escribirnos directamente a sac@casaschilespa.cl\n para ayudarte.\n\nNuestro compromiso es seguir mejorando y entregar soluciones responsables a cada uno de nuestros clientes."",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1770071162000000,""reply_updated_at_unix_micros"":1770071162000000,""published_at"":""2026-01-20T21:41:38.154915Z""},{""Name"":""Juan Pablo Quiroz"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjXcXg6Z1wL9tI6JwaqgPsaaXcWDNtSvylxU38FhW1ZNrUlFD6eG=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Hace poco realicé una compra en Casas Chile SpA y mi experiencia fue muy positiva. Desde el inicio, la atención fue ágil y clara; resolvieron todas mis consultas y me guiaron adecuadamente para elegir el modelo más conveniente según mis necesidades."",""Images"":null,""When"":""5 months ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT2tsTlRtZ3lNMnRKU25CRGIzVm1VVkphYm5jMk1FRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/103983832805498210971/reviews?hl=en-GB"",""posted_at_unix_micros"":1776385347365851,""updated_at_unix_micros"":1776385347365851,""language"":""es"",""translated_lang"":""en"",""text_original"":""Hace poco realicé una compra en Casas Chile SpA y mi experiencia fue muy positiva. Desde el inicio, la atención fue ágil y clara; resolvieron todas mis consultas y me guiaron adecuadamente para elegir el modelo más conveniente según mis necesidades."",""text_translated"":""I recently made a purchase from Casas Chile SpA and my experience was very positive. From the start, the service was quick and clear; they answered all my questions and guided me appropriately in choosing the most suitable model for my needs."",""published_at"":""2026-04-17T00:22:27.365851Z""},{""Name"":""belen pinto"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjVV1NSyBgPJfBseJklnjzzQiTIpqClByjJUEUxY9cQQNLwyTzLt=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Después de investigar varias opciones, decidimos acercarnos a Casas Chile por las recomendaciones. La atención fue súper clara desde el primer momento; se nota que conocen el rubro y no te presionan, sino que te orientan según lo que realmente necesitas. Muy conformes con la gestión inicial y la disposición para resolver dudas."",""Images"":null,""When"":""5 months ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT25SUFFsOXllVjlFYURRNVQzQkNPR1JFTUhCQk0zYxAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/108849416283677278124/reviews?hl=en-GB"",""posted_at_unix_micros"":1776473448677347,""updated_at_unix_micros"":1776473448677347,""language"":""es"",""translated_lang"":""en"",""text_original"":""Después de investigar varias opciones, decidimos acercarnos a Casas Chile por las recomendaciones. La atención fue súper clara desde el primer momento; se nota que conocen el rubro y no te presionan, sino que te orientan según lo que realmente necesitas. Muy conformes con la gestión inicial y la disposición para resolver dudas."",""text_translated"":""After researching several options, we decided to contact Casas Chile based on recommendations. Their service was excellent from the start; it's clear they know their business and they don't pressure you, but rather guide you according to your actual needs. We were very pleased with their initial approach and their willingness to answer any questions."",""published_at"":""2026-04-18T00:50:48.677347Z""}]",null,
