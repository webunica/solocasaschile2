12245843-228c-4c3a-80a8-6c8b5980b16c,https://www.google.com/maps/place/Casas+Rio+Bueno/data=!4m7!3m6!1s0x9616490bea01610b:0x1f5603010972ead0!8m2!3d-40.529585!4d-73.0720669!16s%2Fg%2F11rgdvpwf0!19sChIJC2EB6gtJFpYR0OpyCQEDVh8?authuser=0&hl=en&g_ep=EgoyMDI2MDkxNS4wIJJjKgBIAVAD&rclk=1,Casas Rio Bueno,Modular home builder,"Casas Rio Bueno - Ruta 5 km 913, Osorno, Los Lagos","{""Friday"":[""9 AM–7 PM""],""Monday"":[""9 AM–7 PM""],""Saturday"":[""9 AM–4 PM""],""Sunday"":[""Closed""],""Thursday"":[""9 AM–7 PM""],""Tuesday"":[""9 AM–7 PM""],""Wednesday"":[""9 AM–7 PM""]}",{},http://www.casasriobueno.cl/,9 9196 1165,FWCH+55 Osorno,33,4.500000,"{""1"":1,""2"":1,""3"":3,""4"":2,""5"":26}",-40.529585,-73.072067,2257995566161259216,,,,https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmhCgQ8SLxdn3Hs-to-0y8aUXOqdGX_OW7AsmdbtHU6LLzDaHaHMY-ThsRSHeyYB-Ez0G4NsrYNEpyA1zculX96JF9FlCVoqTiJZsHWIA96N7rv-nkfEvxCr7ZPl4sXhV3LuzrP=w408-h408-k-no,America/Santiago,,0x9616490bea01610b:0x1f5603010972ead0,https://www.google.com/maps/@?api=1&map_action=pano&pano=7WpfW-ruJmPvH9ngMUfzZw,ChIJC2EB6gtJFpYR0OpyCQEDVh8,"[{""title"":""All"",""image"":""https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmhCgQ8SLxdn3Hs-to-0y8aUXOqdGX_OW7AsmdbtHU6LLzDaHaHMY-ThsRSHeyYB-Ez0G4NsrYNEpyA1zculX96JF9FlCVoqTiJZsHWIA96N7rv-nkfEvxCr7ZPl4sXhV3LuzrP=w298-h298-k-no""},{""title"":""By owner"",""image"":""https://lh3.googleusercontent.com/gps-cs-s/AHRPTWlH0F_k-pWJfQMrtUjcB-iSjogcC-XTsW5og0YZQRhuNmy8QensltmaZ1ex375Im9A2KnfojuiryK-ajDV68tWc72JLdB7_JiFAntl4hwrMYf5kHoCrnNDSuCb-90lXzqBCnK3R6jQsTfE=w397-h298-k-no""},{""title"":""Street View \u0026 360°"",""image"":""https://streetviewpixels-pa.googleapis.com/v1/thumbnail?panoid=7WpfW-ruJmPvH9ngMUfzZw\u0026cb_client=maps_sv.tactile.gps\u0026w=224\u0026h=298\u0026yaw=111.06938\u0026pitch=0\u0026thumbfov=100""}]",null,null,"{""link"":"""",""source"":""""}","{""id"":""118397327528616283288"",""name"":""Casas Rio Bueno (Owner)"",""link"":""https://www.google.com/maps/contrib/118397327528616283288""}","{""borough"":"""",""street"":""Ruta 5 km 913"",""city"":""Osorno"",""postal_code"":"""",""state"":""Los Lagos"",""country"":""CL""}",,"[{""id"":""parking"",""name"":""Parking"",""options"":[{""name"":""Free parking lot"",""enabled"":true},{""name"":""On-site parking"",""enabled"":true}]}]","[{""Name"":""Ariel Castro"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjVlUtjzxJUCsP77MzwLsJ-hD24Mhhdo3iAymj9HSPSCHhvo88xdsQ=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Compramos en febrero,  llegamos con una idea, nos asesoraron, en conjunto llegamos a una opcion que la verdad en terreno me pareció genial, ya con contrato firmado se me ocurre hacer una modificación la hicieron sin ningún problema y con toda la voluntad. Por motivos de trabajo no pude estar 100% en la obra, y la verdad pensaba en si lo harían bien o no, sin estar uno encima, llegue y todo bien, paredes a nivel, tabiqueria a 60 cm(gran detalle), la unión de los paneles con separación de mm lo cual es bueno para futuro sellar y aislar, nuestra opción de compra fue de armado de casa, ventanas y puertas, techo en terraza, tapacan y alerón, en tapacan y alerón se ve el detalle y el profesionalismo con el que trabajan ya qe tiene varios cortes pequeños y uniones, están todas al 100%, la post venta impecable, una vez entregada la obra en general ,quedaron mínimos detalles y el servicio post venta 100% eficaz, solucionaron los problemas, si están buscando opciones, acá es!! Mi casa se ubica en osorno, arta lluvia estos días y cero goteras! La verdad da gusto trabajar con gente seria y comprometida como casas rio bueno!"",""Images"":[""https://lh3.googleusercontent.com/grass-cs/ACvplmPvAonjBeYqYMmgzTaHavAg9oJ4XXPHuCo8eK26155OZZDFWlqUXznXt-KqFRuNg1JdRmkFSnm7Zf_x7KAFuqMeZNZgXuWBExfEpniZNj6IonP5NDZpV8Y6VyG2jfuo-r9Ky6iW=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmPfs5XfTaroCvOanNB2kXJW1aD2rB1WoLL_HbxJsodVDEsj9Rq6jchk7og35xNDZ-VuCrJaoN0Orkgw_ENQoLrm244Cp0sYxGHqGuqm5YIaJiZfY92973J9k3Et-Kczr685asOX6Q=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmMzXEV9KwZK28sSZa6lpuTz7j18IgN41mlVC031qmUbdEUIcicyPWctnbWGUICQGCvsDwuCCtKHp8v3uq1_hRuvu87SZrEEHZvhYjKtkCwSM8Y2TIJ6f_BMB7SZZjGz5hoN9a9H=k-no""],""When"":""a year ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnTURvaDVYTjVnRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/102439537415598807812/reviews?hl=en-GB"",""posted_at_unix_micros"":1745929578091525,""updated_at_unix_micros"":1745929578091525,""language"":""es"",""translated_lang"":""en"",""text_original"":""Compramos en febrero,  llegamos con una idea, nos asesoraron, en conjunto llegamos a una opcion que la verdad en terreno me pareció genial, ya con contrato firmado se me ocurre hacer una modificación la hicieron sin ningún problema y con toda la voluntad. Por motivos de trabajo no pude estar 100% en la obra, y la verdad pensaba en si lo harían bien o no, sin estar uno encima, llegue y todo bien, paredes a nivel, tabiqueria a 60 cm(gran detalle), la unión de los paneles con separación de mm lo cual es bueno para futuro sellar y aislar, nuestra opción de compra fue de armado de casa, ventanas y puertas, techo en terraza, tapacan y alerón, en tapacan y alerón se ve el detalle y el profesionalismo con el que trabajan ya qe tiene varios cortes pequeños y uniones, están todas al 100%, la post venta impecable, una vez entregada la obra en general ,quedaron mínimos detalles y el servicio post venta 100% eficaz, solucionaron los problemas, si están buscando opciones, acá es!! Mi casa se ubica en osorno, arta lluvia estos días y cero goteras! La verdad da gusto trabajar con gente seria y comprometida como casas rio bueno!"",""text_translated"":""We bought in February. We arrived with an idea, they advised us, and together we arrived at an option that, honestly, seemed great to me on-site. Even after the contract was signed, I decided to make a modification, which they did without any problem and with complete willingness. Due to work commitments, I couldn't be 100% present at the construction site, and I was honestly wondering if they would do a good job without me being there. When I arrived, everything was fine: level walls, partition walls at 60 cm (a great detail), and the panel joints were separated by millimeters, which is good for future sealing and insulation. Our purchase option included the house assembly, windows and doors, terrace roof, fascia board, and eaves. The fascia board and eaves show the detail and professionalism with which they work, as they have several small cuts and joints, all of which are perfect. The after-sales service was impeccable. Once the project was generally handed over, only minor details remained, and the after-sales service was 100% effective; they resolved any problems. If you're looking for options, this is the place! My house is located in Osorno, it's been raining a lot lately and there haven't been any leaks! It's truly a pleasure working with serious and committed people like Casas Rio Bueno!"",""reply_text"":""Thank you so much for your review, it motivates us to keep improving!"",""reply_text_original"":""Muchas gracias por su reseña, nos motiva a seguir mejorando!!"",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1745945949000000,""reply_updated_at_unix_micros"":1745945949000000,""published_at"":""2025-04-29T12:26:18.091525Z""},{""Name"":""Jose Valdes"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocIyP-N3jIKuIkJ87XCP1uO4tBDmrSZTYwUEtFSbb9D2-ZvEqw=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Bueno nos encontramos con una empresa seria nos construyeron una cabaña en puyehue muy linda y de buena calidad ,cumplieron con los plazos bien ubicada con muy buenos materiales y preocupados de las terminaciones cumplen con los sueños de nosotros los que queremos emigrar al sur de chile 200 por ciento recomendsble Manuel y Samuel  muy preocupados de nuestra cabaña en un futuro próximo si tengo que instalar otra cabaña no lo pienso casas rio bueno lo mejor de osorno"",""Images"":[""https://lh3.googleusercontent.com/grass-cs/ACvplmPtqhJBXnN7e8Aw2hE5pKdjCyuajdTn47ehIsBU6C2GTjl9N9Z4Dv-msA7ax-dQ9Kt2ndQLtEETCxuoevKTp40BavmW7AXDgf9MF95bgU4_LE7i10qQgBgsGkB8hwK_gNRH49Bs=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmOGchQzIkE8SutFuy_jHtWH53kmKMjwrIK6NaZQjvk6aDz0K-yBa8kLRLzUAfARiLB0O940fzgSL1_fzHCR3I9U-Vid2lCeOGTtlnJCrA2-gvGmo4148xezXT6KERXhD0oLSQDqiQ=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmNOd_tI2-p4szcjSo2xjZn9HUhADYGhgNeUdzxwuLoRiHLUDmPsBlR0Ue-oAZr7dtyiC-wB3sA8IBvaoRI15VwlKFfJ9Xi59ltO8yAqbwk4a2eaz9xV-Htji7MFgbSw6Q_vOiBj=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmPREmVIdE1vZ3PiGjvIr3CjOMA4FiurUI1udACKj8bohjq5SfuCHsACW50P98J6fsVDdH6szYvLcOxwuJV8d3F_JKgi2Ohtz7_JJduOwLv5lHexjUR0wmI0mnsbZcdMsoEYGJ7R=k-no"",""https://lh3.googleusercontent.com/grass-cs/ACvplmMyXIvdzb8bJbJPgGmULFA0cz5iJy-ysyc3Po4GanZGdgAca-rWBaRobS8nUqk8_MNZwwRQ7M8cLGgX68GS5YZOYPjCiPAVdpa5y91yRGJbP9u_M_FfIwlK6I7Hk_1u3-3raoE=k-no""],""When"":""4 years ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSUR1eDhLaXBnRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/104657717207004675545/reviews?hl=en-GB"",""posted_at_unix_micros"":1661909479486693,""updated_at_unix_micros"":1661909995469070,""language"":""es"",""translated_lang"":""en"",""text_original"":""Bueno nos encontramos con una empresa seria nos construyeron una cabaña en puyehue muy linda y de buena calidad ,cumplieron con los plazos bien ubicada con muy buenos materiales y preocupados de las terminaciones cumplen con los sueños de nosotros los que queremos emigrar al sur de chile 200 por ciento recomendsble Manuel y Samuel  muy preocupados de nuestra cabaña en un futuro próximo si tengo que instalar otra cabaña no lo pienso casas rio bueno lo mejor de osorno"",""text_translated"":""We found a reputable company that built us a beautiful, high-quality cabin in Puyehue. They met the deadlines, the location was excellent, they used very good materials, and they paid close attention to the finishing touches. They fulfilled the dreams of those of us who want to move to southern Chile. 200% recommended. Manuel and Samuel were very attentive to our cabin. If I need to build another cabin in the near future, I won't hesitate to choose Casas Rio Bueno, the best in Osorno."",""reply_text"":""Thank you so much, Don José! We continue to improve our processes, and these comments give us even more motivation! Best regards."",""reply_text_original"":""Muchos gracias don José, seguimos avanzando mejorando los procesos y estos comentarios nos da aún más fuerzas!! Saludos."",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1661941429000000,""reply_updated_at_unix_micros"":1661941429000000,""published_at"":""2022-08-31T01:31:19.486693Z""},{""Name"":""Alejandra Mariman"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjXxNmhKIX5KbzcbC2OI3YkkeaJkLz5Z27sRYPrMPJKS1ahM7IU2=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Cumplieron con los plazos establecidos,  las personas que instalaron la casa muy respetuosas y puntuales.\nAdemás pude modificar la casa a mi requerimiento , excelente atención."",""Images"":[""https://lh3.googleusercontent.com/grass-cs/ACvplmOXP_zha1n_2SDCIZK0ngvviUU60uxj3mqaBSyapLi06aPNa6Zd-5S0joG97Ed5hiVmRBUcaDUXy7HxyZ_KSZf3b6oFQChv_4OOFCkcDiFdN2ziWc4e-sOO-C3uJ0R3AGz8ThApabblDdRD=k-no""],""When"":""11 months ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT25Cc2JteHJZVjlqYUZGM1NITjRNVEJoV1RsRE0xRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/106388914237100542837/reviews?hl=en-GB"",""posted_at_unix_micros"":1758559864455193,""updated_at_unix_micros"":1758559864455193,""language"":""es"",""translated_lang"":""en"",""text_original"":""Cumplieron con los plazos establecidos,  las personas que instalaron la casa muy respetuosas y puntuales.\nAdemás pude modificar la casa a mi requerimiento , excelente atención."",""text_translated"":""They met the established deadlines, and the people who installed the house were very respectful and punctual.\nI was also able to modify the house to my specifications; excellent service."",""published_at"":""2025-09-22T16:51:04.455193Z""},{""Name"":""Sebastián V"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocIa3sd8Jpx5vj_pUObBkZhOTjCLJPYLzp85HaH4Twd75JOb800=s120-c-rp-mo-br100"",""Rating"":3,""Description"":""Mi madre les mandó a hacer una cabaña de lo cuál puedo observar lo siguiente:\n- Se les pide que cambien de lugar una puerta y una ventana, pero en terreno los maestros no sabían del asunto.\n- Algunas de las secciones de los tabiques estaban demasiado verdes, lo que generó que algunas paredes no quedaran derechas.\n- Quedó una gotera, probablemente porque el techo tiene varias aberturas producto de una baja cuantía de madera y porque el papel negro quedó rasgado en varios lugares (parece que andaban cortos de materiales).\n- Lo bueno es que cumplen con los plazos y la razón precio calidad es aceptable, pero hay que andar alerta para que algunos maestros hagan las cosas bien."",""Images"":null,""When"":""2 years ago"",""review_id"":""ChZDSUhNMG9nS0VJQ0FnSUQxaDRiM0R3EAE"",""source"":""Google"",""rating_scale"":5,""rating_float"":3,""author_url"":""https://www.google.com/maps/contrib/114452785849099861636/reviews?hl=en-GB"",""posted_at_unix_micros"":1704901281386981,""updated_at_unix_micros"":1704901729712451,""language"":""es"",""translated_lang"":""en"",""text_original"":""Mi madre les mandó a hacer una cabaña de lo cuál puedo observar lo siguiente:\n- Se les pide que cambien de lugar una puerta y una ventana, pero en terreno los maestros no sabían del asunto.\n- Algunas de las secciones de los tabiques estaban demasiado verdes, lo que generó que algunas paredes no quedaran derechas.\n- Quedó una gotera, probablemente porque el techo tiene varias aberturas producto de una baja cuantía de madera y porque el papel negro quedó rasgado en varios lugares (parece que andaban cortos de materiales).\n- Lo bueno es que cumplen con los plazos y la razón precio calidad es aceptable, pero hay que andar alerta para que algunos maestros hagan las cosas bien."",""text_translated"":""My mother had them build a cabin, and I can observe the following:\n- They were asked to move a door and a window, but the workers on site didn't know how.\n\n- Some sections of the partition walls were too green, which resulted in some walls not being straight.\n\n- There was a leak, probably because the roof has several openings due to a shortage of wood and because the black wallpaper was torn in several places (it seems they were short on materials).\n\n- The good thing is that they meet deadlines, and the price-quality ratio is acceptable, but you have to be vigilant to ensure that some of the workers do things properly."",""published_at"":""2024-01-10T15:41:21.386981Z""},{""Name"":""David Casadidio"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocLkRiG73-2eU92pLU6ocM_LknQYGDyONb4b8HrBAEGBrIlUGxE=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Muy buen trabajo, buena atención y predisposición. En tiempo y forma. Totalmente recomendable!"",""Images"":null,""When"":""a year ago"",""review_id"":""Ci9DQUlRQUNvZENodHljRjlvT25GNmFtTkVkSGRNTUV0dVlreHRaVzVrVGtkeE5uYxAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/102939876671591275824/reviews?hl=en-GB"",""posted_at_unix_micros"":1752598121193647,""updated_at_unix_micros"":1752598121193647,""language"":""es"",""translated_lang"":""en"",""text_original"":""Muy buen trabajo, buena atención y predisposición. En tiempo y forma. Totalmente recomendable!"",""text_translated"":""Excellent work, great 