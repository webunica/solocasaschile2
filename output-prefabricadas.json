98-h298-k-no""},{""title"":""Street View \u0026 360°"",""image"":""https://streetviewpixels-pa.googleapis.com/v1/thumbnail?panoid=1tzs5_R_HttD9skAuQuaVg\u0026cb_client=maps_sv.tactile.gps\u0026w=224\u0026h=298\u0026yaw=284.066\u0026pitch=0\u0026thumbfov=100""}]",null,null,"{""link"":"""",""source"":""""}","{""id"":""102510257251364354086"",""name"":""CONSTRUKIT - Casas Industrializadas de Alto Estándar (Owner)"",""link"":""https://www.google.com/maps/contrib/102510257251364354086""}","{""borough"":"""",""street"":""Ruta Panamericana Sur Km. 680"",""city"":""Temuco, Padre Las Casas"",""postal_code"":"""",""state"":""Araucania"",""country"":""CL""}",,null,"[{""Name"":""Paz Rodríguez"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocJyQCnvdRwsoB0tBH-K20rJBezf_uoa4M5AdBbt37EnkAO0XKY=s120-c-rp-mo-ba12-br100"",""Rating"":5,""Description"":""Excelente empresa y los servicios que brindan. Buena calidad en los materiales y trabajos que realizan.\nEl personal de atención a público es muy cordial y siempre están atentos a las necesidades del cliente."",""Images"":null,""When"":""2 years ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSUM3NlpQdTBRRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/110991630093575066448/reviews?hl=en-GB"",""posted_at_unix_micros"":1723850667561970,""updated_at_unix_micros"":1723850667561970,""language"":""es"",""translated_lang"":""en"",""text_original"":""Excelente empresa y los servicios que brindan. Buena calidad en los materiales y trabajos que realizan.\nEl personal de atención a público es muy cordial y siempre están atentos a las necesidades del cliente."",""text_translated"":""Excellent company and services. High-quality materials and workmanship.\nThe customer service staff is very friendly and always attentive to customer needs."",""reply_text"":""We are delighted by your thorough and positive review!\n\nWe are thrilled to hear that your experience was excellent in every way. We strive to offer high-quality services, using the best materials and relying on a professional team that pays attention to every detail.\n\nAnd of course, our priority is to provide friendly and attentive service to every customer! We greatly appreciate you taking the time to share your opinion.\nComments like yours motivate us to continue improving and maintaining our commitment to excellence.\n\nBest regards, CONSTRUKIT Team"",""reply_text_original"":""Nos alegra mucho su reseña tan completa y positiva!\n\nNos entusiasma saber que tu experiencia ha sido excelente en todos los aspectos.Nos esforzamos mucho por ofrecer servicios de alta calidad, utilizando los mejores materiales y contando con un equipo profesional que se preocupa por cada detalle. \n\nY por supuesto, ¡nuestra prioridad es brindar una atención cordial y atenta a cada cliente!Agradecemos mucho que te hayas tomado el tiempo de compartir tu opinión. \nComentarios como el tuyo nos motivan a seguir mejorando y a mantener nuestro compromiso con la excelencia.\n\nSaludos\nEquipo CONSTRUKIT"",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1738174570000000,""reply_updated_at_unix_micros"":1738175142000000,""published_at"":""2024-08-16T23:24:27.56197Z""},{""Name"":""Gloria Zambrano Arias"",""ProfilePicture"":""https://lh3.googleusercontent.com/a-/ALV-UjXi0kQhKgd4aJn8naYYu6Xvf7fn77y839vEHsQaB76aniwLwObd=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Excelente experiencia con esta empresa, su atención personalizada y la permanente preocupación por cada detalle en este proyecto de construcción han sido lo que marca la diferencia con otros lugares. Recomiendo esta empresa para todo quien sueña su casa con altos estándares de calidad  y diseño. Muy agradecida."",""Images"":null,""When"":""a year ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSURuODZiUmpBRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/116697028245591427847/reviews?hl=en-GB"",""posted_at_unix_micros"":1728512073984134,""updated_at_unix_micros"":1728512073984134,""language"":""es"",""translated_lang"":""en"",""text_original"":""Excelente experiencia con esta empresa, su atención personalizada y la permanente preocupación por cada detalle en este proyecto de construcción han sido lo que marca la diferencia con otros lugares. Recomiendo esta empresa para todo quien sueña su casa con altos estándares de calidad  y diseño. Muy agradecida."",""text_translated"":""Excellent experience with this company. Their personalized attention and constant attention to every detail in this construction project have truly set them apart from other places. I highly recommend this company to anyone dreaming of a home built to high standards of quality and design. Thank you so much."",""reply_text"":""What a joy to read your comment!\n\nWe're thrilled to know your experience with us has been so positive. We strive to make every project unique and special.\n\nWe deeply appreciate your trust and your kind words about our personalized attention and care for detail.\n\nThis motivates us to continue working with the same dedication and commitment to offer high standards of quality and design in every project.\n\nBest regards, The CONSTRUKIT Team"",""reply_text_original"":""¡Qué alegría leer tu comentario! \nNos emociona saber que tu experiencia con nosotros ha sido tan positiva, nos esforzamos al máximo para que cada proyecto sea único y especial.\n\nAgradecemos profundamente tu confianza y tus amables palabras sobre nuestra atención personalizada y preocupación por los detalles.\n Nos motiva a seguir trabajando con la misma dedicación y compromiso para ofrecer altos estándares de calidad y diseño en cada proyecto.\n\nSaludos\nEquipo CONSTRUKIT"",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1738174305000000,""reply_updated_at_unix_micros"":1738175096000000,""published_at"":""2024-10-09T22:14:33.984134Z""},{""Name"":""Veronica Loreto Sepulveda Miranda"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocJ__c9M5T3rWutBLj4vII01zVhbMAa2ZQyfhUaJdkctUSx_=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Excelente empresa, atención 100% personalizada y nos asesoraron durante todo el proceso. Logramos construir nuestra casa de ensueño. Agradecemos a Leslie por su excelente atención y acompañamiento durante todo el proyecto."",""Images"":null,""When"":""2 years ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSUM3c2JEU25nRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/106855990704198264889/reviews?hl=en-GB"",""posted_at_unix_micros"":1723820026937579,""updated_at_unix_micros"":1723820026937579,""language"":""es"",""translated_lang"":""en"",""text_original"":""Excelente empresa, atención 100% personalizada y nos asesoraron durante todo el proceso. Logramos construir nuestra casa de ensueño. Agradecemos a Leslie por su excelente atención y acompañamiento durante todo el proyecto."",""text_translated"":""Excellent company, 100% personalized service, and they guided us throughout the entire process. We were able to build our dream home. We thank Leslie for her excellent attention and support throughout the project."",""reply_text"":""We're so happy to read your comment!\n\nWe're thrilled to know that you fulfilled your dream of building your home and that you felt supported and guided every step of the way by our team.\n\nAt CONSTRUKIT, we're passionate about making our clients' dreams a reality, and we strive to provide 100% personalized attention, guiding them through each stage of the process.\nWe'll pass on your congratulations to our architect; she'll be delighted to know that you appreciate her dedication and support! We wish you all the best in your new home!\n\nBest regards, The CONSTRUKIT Team"",""reply_text_original"":""¡Qué alegría nos da leer tu comentario! \n\nNos emociona saber que cumpliste el sueño de construir tu casa y que te sentiste acompañado y asesorado en todo momento por nuestro equipo.\n\nEn CONSTRUKIT nos apasiona hacer realidad los sueños de nuestros clientes, y nos esforzamos por brindar una atención 100% personalizada, guiándolos en cada etapa del proceso.\nTransmitiremos tus felicitaciones a nuestra Arquitecta, ¡le encantará saber que valoras su dedicación y apoyo! ¡Te deseamos lo mejor en tu nuevo hogar! \n\nSaludos\nEquipo CONSTRUKIT"",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1738174949000000,""reply_updated_at_unix_micros"":1738175244000000,""published_at"":""2024-08-16T14:53:46.937579Z""},{""Name"":""Hernán Jara"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocKKHpSK94TRpF7d2e_utG-Amqgwau_jdkgwku5RS-hcFK0qeg=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Excelente servicio de principio a fin, rápida respuesta, excelente calidad de los materiales . 100% recomendable ."",""Images"":null,""When"":""2 years ago"",""review_id"":""ChdDSUhNMG9nS0VJQ0FnSUM3cWF5YXVBRRAB"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/116173965916133401750/reviews?hl=en-GB"",""posted_at_unix_micros"":1723839872303095,""updated_at_unix_micros"":1723839872303095,""language"":""es"",""translated_lang"":""en"",""text_original"":""Excelente servicio de principio a fin, rápida respuesta, excelente calidad de los materiales . 100% recomendable ."",""text_translated"":""Excellent service from start to finish, quick response, excellent quality of materials. 100% recommended."",""reply_text"":""Hello! We're so happy to read your review and know that your experience with us was so positive from beginning to end.\n\nAt CONSTRUKIT, we strive to provide fast, efficient service with the highest quality materials, so comments like yours confirm that we're on the right track.\n\nThank you so much for your recommendation! We hope to continue earning your trust in the future.\n\nBest regards, The CONSTRUKIT Team"",""reply_text_original"":""¡Hola! Nos alegra muchísimo leer tu reseña y saber que tu experiencia con nosotros fue tan positiva de principio a fin.\n\nEn CONSTRUKIT nos esforzamos por brindar un servicio rápido, eficiente y con materiales de la mejor calidad, por lo que comentarios como el tuyo nos confirman que vamos por buen camino.\n\n¡Agradecemos mucho tu recomendación! Esperamos poder seguir contando con tu confianza en el futuro.\n\n\nSaludos\nEquipo CONSTRUKIT"",""reply_language"":""es"",""reply_translated_lang"":""en"",""reply_posted_at_unix_micros"":1738174841000000,""reply_updated_at_unix_micros"":1738174841000000,""published_at"":""2024-08-16T20:24:32.303095Z""},{""Name"":""VALENZUELA CID ERIKA BELEN"",""ProfilePicture"":""https://lh3.googleusercontent.com/a/ACg8ocKgsWfSPUJ8uCRoniXieR7FEp-m49pDDQAq-MJ3c4s_vBnG6Q=s120-c-rp-mo-br100"",""Rating"":5,""Description"":""Excelente atención. Muy profesionales y responsables. Muy buena calidad humana además."",""Images"":null,""When"":""2 years ago"",""review_id"":""ChZDSUhNMG9nS0VJQ0FnSUM3cWZHcUZREAE"",""source"":""Google"",""rating_scale"":5,""rating_float"":5,""author_url"":""https://www.google.com/maps/contrib/113610194575546922119/reviews?hl=en-GB"",""posted_at_unix_micros"":1723841951242501,""updated_at_unix_micros"":1723841951242501,""language"":""es"",""translated_lang"":""en"",""text_original"":""Excelente atención. Muy profesionales y responsables. Muy buena calidad humana además."",""text_translated"":""Excellent service. Very professional and responsible. They also have great interpersonal skills."",""reply_text"":""We're so glad to read your review!\n\nWe're thrilled to hear that your experience with us was so positive.\n\nWe strive to provide professional and responsible service, but we also believe that human connection is essential in every interaction.\n\nWe're happy you felt th